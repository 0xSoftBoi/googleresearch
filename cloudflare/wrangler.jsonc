// Cloudflare edge front end for the TimesFM-3 Forecast Service.
//   npx wrangler dev            # local, against API_ORIGIN
//   npx wrangler deploy         # needs CLOUDFLARE_API_TOKEN (Workers Scripts:Edit, KV:Edit)
//   npx wrangler secret put API_KEY / ADMIN_TOKEN / LEADS_WEBHOOK
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timesfm3-edge",
  "main": "src/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    // Route every request through the Worker (it falls back to ASSETS.fetch);
    // otherwise browser navigations to /app or /docs hit the 404 page first.
    "run_worker_first": true
  },
  "kv_namespaces": [
    // Created 2026-09-02 in the connected account ("timesfm3-edge"); holds leads only.
    { "binding": "EDGE_KV", "id": "1df8ae6bdb5a41eabdd00beb32118817" }
  ],
  // Privacy Pass double-spend ledger (token nonces + counters). Created 2026-09-02 in the
  // connected account; `npx wrangler d1 migrations apply timesfm3-credits` (add --local for dev).
  "d1_databases": [
    { "binding": "PRIVACY_PASS_DB", "database_name": "timesfm3-credits", "database_id": "10503e65-8f18-4803-890f-809025735489", "migrations_dir": "migrations" }
  ],
  // Per-IP limit through the Workers rate-limit binding (free; no KV writes).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Leave API_ORIGIN empty for the free edge-native mode (classical models in
    // the Worker, TimesFM-3 in the browser). Set it to a self-hosted
    // `timesfm3 serve` to turn the Worker into a gateway for the full API.
    "API_ORIGIN": "",
    "RATE_LIMIT_PER_MINUTE": "30",
    "MAX_BODY_BYTES": "1048576",
    "ALLOWED_ORIGINS": "*",
    // x402 pay-per-call (USDC). Set X402_PAY_TO to your wallet to enable; the
    // paywall applies to anonymous callers in gateway mode, and to the edge
    // classical API only when X402_PAYWALL_EDGE_NATIVE is "1".
    "X402_PAY_TO": "",
    "X402_NETWORK": "eip155:84532",
    "X402_PAYWALL_EDGE_NATIVE": "0",
    // Privacy Pass issuer (RFC 9578): set the secret PRIVACY_PASS_PRIVATE_JWK
    // (scripts/credits_keygen.py); after rotation list old public JWKs here.
    "PRIVACY_PASS_OLD_PUBLIC_JWKS": "[]",
    "PRIVACY_PASS_ISSUER_NAME": "",
    "PRIVACY_PASS_ORIGIN": "",
    "CREDITS_PRICE_USD": "0.004"
  }
  // Custom domain (uncomment after adding the zone to the account):
  // "routes": [{ "pattern": "forecast.example.com", "custom_domain": true }]
}
